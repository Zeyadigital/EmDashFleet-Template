#!/bin/sh
# Runs before every commit: gitleaks on the staged changes (app plan, Security:
# gitleaks as a pre-commit hook on every repository). Enable it once per clone
# with
#   git config core.hooksPath .githooks
# and install gitleaks 8.30.1, the version template-checks.yml runs
# (README, Maintaining the template). It never runs on its own: a site
# repository created from the template has no hooks path set.
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed; install 8.30.1 (README, Maintaining the template)" >&2
	exit 1
fi
gitleaks git --pre-commit --redact --staged --no-banner
